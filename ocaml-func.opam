opam-version: "2.0"
version: "0.1.0"
synopsis: "FunC utilities"
description: "Provides FunC parser and AST"
maintainer: ["Georgiy Komarov <jubnzv@gmail.com>"]
authors: ["Georgiy Komarov"]
license: "LGPL-3.0-or-later"
homepage: "https://github.com/nowarp/ocaml-func"
bug-reports: "https://github.com/nowarp/ocaml-func/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.0"}
  "core"
  "core_unix"
  "ppx_deriving" {build}
  "zarith"
  "cmdliner"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/nowarp/ocaml-func.git"
